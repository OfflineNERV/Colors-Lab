@startuml usecase
' Use Case Diagram - COLORS web application (Labs 1-3)
left to right direction
skinparam actorStyle awesome

actor "User" as User
actor "MySQL Database\n(COP4331)" as DB <<system>>

rectangle "COLORS Web Application" {
  usecase "Log In" as UC_Login
  usecase "Log Out" as UC_Logout
  usecase "Add Color" as UC_Add
  usecase "Search Colors" as UC_Search
}

User --> UC_Login
User --> UC_Logout
User --> UC_Add
User --> UC_Search

UC_Login --> DB
UC_Add --> DB
UC_Search --> DB

note right of UC_Login
  Login.php: SELECT ID, firstName, lastName
  FROM Users WHERE Login=? AND Password=?
end note

note bottom of UC_Search
  Precondition for Add / Search / Log Out:
  user is logged in. color.html runs readCookie()
  on load and redirects to index.html if no userId.
end note
@enduml
